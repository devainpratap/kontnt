HOST=127.0.0.1
PORT=3001
WORKFLOW_ROOT=.
DB_PATH=./data/workflow.sqlite
# Writing engine:
#   claude     = Claude Code CLI via your Claude subscription (Max/Pro) — DEFAULT, no API key
#   claude-api = Anthropic Messages API (requires ANTHROPIC_API_KEY)
#   codex      = Codex CLI
GENERATION_PROVIDER=claude

# Claude Code CLI (used by the default "claude" provider — powered by your subscription login)
CLAUDE_CLI_BIN=claude
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_TIMEOUT_MS=600000

# Only needed when GENERATION_PROVIDER=claude-api
ANTHROPIC_API_KEY=
ANTHROPIC_EFFORT=high
ANTHROPIC_MAX_TOKENS=64000

# Codex CLI — used only when GENERATION_PROVIDER=codex
CODEX_CLI_BIN=codex
CODEX_MODEL=
CODEX_SANDBOX=workspace-write
CODEX_TIMEOUT_MS=300000
CODEX_MAX_OUTPUT_BYTES=5000000
GENERATION_FALLBACK_MODE=manual
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVE_WEB=false
VITE_API_PROXY_TARGET=http://localhost:3001
