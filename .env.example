HOST=127.0.0.1
PORT=3001
WORKFLOW_ROOT=.
DB_PATH=./data/workflow.sqlite
# Writing engine:
#   claude     = Claude Code CLI via your Claude subscription (Max/Pro) — DEFAULT, no API key
#   claude-api = Anthropic Messages API (requires ANTHROPIC_API_KEY)
#   codex      = Codex CLI
GENERATION_PROVIDER=claude

# Claude Code CLI (used by the default "claude" provider — powered by your subscription login)
CLAUDE_CLI_BIN=claude
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_TIMEOUT_MS=600000

# Only needed when GENERATION_PROVIDER=claude-api
ANTHROPIC_API_KEY=
ANTHROPIC_EFFORT=high
ANTHROPIC_MAX_TOKENS=64000

# Codex CLI — used only when GENERATION_PROVIDER=codex
CODEX_CLI_BIN=codex
CODEX_MODEL=
CODEX_SANDBOX=workspace-write
CODEX_TIMEOUT_MS=300000
CODEX_MAX_OUTPUT_BYTES=5000000
GENERATION_FALLBACK_MODE=manual
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVE_WEB=false
VITE_API_PROXY_TARGET=http://localhost:3001


# ==========================================================================
# RankOS — rank tracking + Search Console intelligence (apps/rank-*)
# Runs alongside ContentOS on its own port and database.
# ==========================================================================
RANK_HOST=127.0.0.1
RANK_PORT=3102
RANK_DB_PATH=./data/rank.sqlite
CLIENTS_ROOT=./clients
RANK_CORS_ALLOWED_ORIGINS=http://localhost:5274,http://127.0.0.1:5274
RANK_SERVE_WEB=false
VITE_RANK_API_PROXY_TARGET=http://localhost:3102

# --- Google Search Console -------------------------------------------------
# One-time setup: Google Cloud Console -> new project -> enable "Google Search
# Console API" -> Credentials -> OAuth client ID -> type "Web application" ->
# add the redirect URI below -> scope https://www.googleapis.com/auth/webmasters.readonly
#
# IMPORTANT: set the OAuth consent screen publishing status to "In production".
# Apps left in "Testing" are issued refresh tokens that EXPIRE AFTER 7 DAYS,
# which silently kills the daily sync. You will see a one-time "unverified app"
# warning you can click through; personal use needs no Google verification.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3102/api/google/callback
# 32-byte key (hex) used to encrypt the stored refresh token at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_KEY=

GSC_BACKFILL_MONTHS=16
# Google revises recent days, so each sync re-pulls this many days and upserts.
GSC_ROLLING_WINDOW_DAYS=5
# Daily query-level detail retained; weekly rollups are kept forever.
GSC_RETENTION_DAYS=90

# --- Live SERP checks ------------------------------------------------------
# ACCURACY NOTE: Google localizes results by the searcher's IP. The free
# providers (serpapi, scrapingrobot) query from datacenter IPs outside your
# client's city, so for locally-competitive keywords they return an over-
# optimistic rank (e.g. #5) that does NOT match what a real local searcher sees
# (e.g. #30). For trustworthy, client-facing positions use dataforseo, which
# searches from real city-level geolocation (set the client's market in the app).
#
# chain         = failover across SERP_PROVIDER_CHAIN (free but non-local vantage).
# dataforseo    = ~$0.002/SERP (live) after a $50 min deposit. ACCURATE. Recommended.
# scrapingrobot = 5,000 free scrapes/month, recurring, no card. Non-local vantage.
# serpapi       = 250 free searches/month, recurring, no card. Non-local vantage.
# local         = your own Chrome/IP. Free and accurate for YOUR city, but Google
#                 rate-limits after ~20 requests. Opt-in escape hatch.
#
# For accurate rank tracking, set:  SERP_PROVIDER=dataforseo  (+ creds below)
SERP_PROVIDER=chain
SERP_PROVIDER_CHAIN=serpapi,scrapingrobot,dataforseo

# Sign up at scrapingrobot.com — no credit card. 5,000 free scrapes/month.
SCRAPINGROBOT_API_KEY=
# Their public API reference is unavailable; the generic HTML module is the
# documented one and is what the driver uses. Override if your account differs.
SCRAPINGROBOT_MODULE=HtmlRequestScraper

# Sign up at serpapi.com — no credit card. 250 free searches/month, 50/hour.
SERPAPI_API_KEY=

# Monthly free allowances. The chain uses these to move to the next provider
# before spending a request to discover it is out of credit. 0 = no free tier.
SCRAPINGROBOT_MONTHLY_FREE=5000
SERPAPI_MONTHLY_FREE=250
SERPER_MONTHLY_FREE=0
DATAFORSEO_MONTHLY_FREE=0

# API providers need no anti-block pacing; the long delay below is browser-only.
SERP_API_DELAY_MS=1000
# Parallel API checks. Forced to 1 for the local browser. Higher = faster batches.
SERP_CONCURRENCY=5

# Re-check each keyword N times and store the majority position, to smooth the
# proxy-rotation noise free providers introduce (measured: a 10/6/10 wobble on
# one keyword). 1 = off. 3 is a good accuracy/cost trade for money keywords, at
# 3x the credit cost. On genuine disagreement the result is stored as unknown,
# never a guessed number.
SERP_CONSENSUS_RUNS=1
SERP_CONSENSUS_DELAY_MS=2000

# MEASURED, not assumed: Google blocks headless Chrome on the very first
# request (redirects to /sorry/). Headed works. Leave this false.
SERP_HEADLESS=false
# Google deprecated num=100 in 2025 and serves 10 results per page, so depth
# costs one request per page. 3 pages = top 30. Checks stop early once the
# client's domain is found, so page-one keywords only cost one request.
SERP_MAX_PAGES=3
SERP_MAX_CHECKS_PER_DAY=150
SERP_MIN_DELAY_MS=25000
SERP_MAX_DELAY_MS=70000
# DataForSeo — accurate, city-level rank tracking (recommended for client reports).
# Sign up at dataforseo.com, add the $50 minimum deposit (prepaid balance, ~$0.002
# per live search so it lasts a very long time), and put the API login/password
# here. Then set SERP_PROVIDER=dataforseo above.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPER_API_KEY=

# --- AI insight reports (uses your Claude subscription, no API key) ---------
RANK_INSIGHT_MODEL=claude-opus-4-8
RANK_INSIGHT_TIMEOUT_MS=600000
RANK_MAX_OUTPUT_BYTES=5000000


# --- Automation (scheduler + alerts) --------------------------------------
# The scheduler runs inside this local server, so it only fires while the
# machine is awake and the server is up. Times are Asia/Kolkata.
SCHEDULER_ENABLED=true
SCHEDULER_GSC_CRON=0 6 * * *
SCHEDULER_SERP_CRON=0 3 * * *
SCHEDULER_REPORT_CRON=0 8 * * 1
# Missed-run recovery: because the scheduler only fires while the machine is up,
# a run scheduled for a time the Mac was asleep/off would be lost (most visibly,
# Monday's report). When enabled, RankOS recovers missed runs on boot and on
# this cadence (hourly), sending a missed weekly report exactly once. Leave on.
# For on-time delivery (not just recovery), also wake the Mac before the morning
# jobs:  sudo pmset repeat wakeorpoweron MTWRFSU 05:10:00
SCHEDULER_CATCHUP_ENABLED=true
SCHEDULER_CATCHUP_CRON=15 * * * *
# Alerts on rank movement, evaluated after each check. Never raised on a
# blocked/unknown reading.
ALERTS_ENABLED=true
ALERT_LARGE_MOVE=5


# --- Weekly report email delivery -----------------------------------------
# The detailed report + the copy-ready WhatsApp brief are emailed to you when
# the weekly report runs (SCHEDULER_REPORT_CRON, Monday 8am). Forward the brief
# to your team group by hand - official, free, zero account-ban risk.
#
# Any SMTP works. For a Google Workspace address (e.g. info@adclear.in):
#   1) Enable 2-Step Verification on the account.
#   2) Create an App Password (Google account -> Security -> App passwords).
#   3) SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=<your address>
#      SMTP_PASS=<the 16-char app password>
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=devain@adclear.in
# Only email these client slugs (comma-separated). Empty = all active clients.
EMAIL_CLIENTS=adclear


# --- Operator (RankOS supervising itself) ---------------------------------
# The operations brain: watches health, auto-fixes safe issues (reconcile stuck
# rows, prune data past retention, retry a failed sync), escalates the rest by
# email. Runs on OPERATOR_CRON, and observe/recommend-only if autonomy=recommend.
OPERATOR_ENABLED=true
OPERATOR_AUTONOMY=auto
OPERATOR_CRON=30 5 * * *
